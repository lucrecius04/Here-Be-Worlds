{
  "_note": "Roztřídění triád světů (Galerie triád /galerie-triad/ a Mapa neznáma /mapa-neznama/). Schváleno majitelem 2026-11-24. Každý publikovaný svět má jeden hlavní typ; `sinAlso` = hraniční případ, ukáže se jako „také: …“. Kdo drží mezeru ověřeno proti oddílu 4. Nosná mezera v kronikách: Zamčeno tvůrci jen tam, kde autoři odpověď výslovně odmítli nebo dílo záměrně nikdy neodhalí.",
  "sinTypes": [
    {
      "id": "zadrzeny-konec",
      "label": { "cs": "Zadržený konec", "en": "The withheld ending" },
      "desc": { "cs": "Něco, co mělo skončit, nesmí skončit – a svět začne hnít.", "en": "Something that should have ended is not allowed to end – and the world begins to rot." }
    },
    {
      "id": "tvor-jako-nastroj",
      "label": { "cs": "Tvor jako nástroj", "en": "The creature as a tool" },
      "desc": { "cs": "Stvořené bytosti jsou materiál, figurky nebo pokusné objekty.", "en": "Created beings are raw material, game pieces or test subjects." }
    },
    {
      "id": "krev-v-zakladech",
      "label": { "cs": "Krev v základech", "en": "Blood in the foundations" },
      "desc": { "cs": "U kořene světa leží vražda, oběť nevinného nebo znesvěcení posvátného.", "en": "At the root of the world lies a murder, an innocent sacrificed or something sacred defiled." }
    },
    {
      "id": "lez-v-zakladech",
      "label": { "cs": "Lež v základech", "en": "A lie in the foundations" },
      "desc": { "cs": "Řád stojí na zatajené pravdě a drží jen, dokud ji nikdo neodhalí.", "en": "The order rests on a hidden truth and holds only until someone uncovers it." }
    },
    {
      "id": "lek-horsi-nez-nemoc",
      "label": { "cs": "Lék horší než nemoc", "en": "A cure worse than the disease" },
      "desc": { "cs": "Dobrý úmysl nebo strach spustí katastrofu, kterou měl odvrátit.", "en": "A good intention or a fear unleashes the very catastrophe it was meant to prevent." }
    },
    {
      "id": "moc-a-zisk",
      "label": { "cs": "Moc a zisk", "en": "Power and profit" },
      "desc": { "cs": "Prestiž, korporace a ovládnutí: svět prodaný za výhodu několika.", "en": "Prestige, corporations and control: a world sold for the advantage of a few." }
    }
  ],
  "dilemmaTypes": [
    {
      "id": "svoboda-nebo-spravce",
      "label": { "cs": "Svoboda, nebo správce", "en": "Freedom or a keeper" },
      "desc": { "cs": "Patří osud lidem, nebo těm, kdo je řídí – bohům, elitám, strojům?", "en": "Does fate belong to people, or to those who steer them – gods, elites, machines?" }
    },
    {
      "id": "lidskost-nebo-preziti",
      "label": { "cs": "Lidskost, nebo přežití", "en": "Humanity or survival" },
      "desc": { "cs": "Kolik z sebe smí člověk obětovat, aby vůbec přežil?", "en": "How much of oneself may be sacrificed just to survive?" }
    },
    {
      "id": "pravda-nebo-mytus",
      "label": { "cs": "Pravda, nebo mýtus", "en": "Truth or myth" },
      "desc": { "cs": "Má se bourat lež, na které stojí společenství?", "en": "Should a lie that holds a community together be torn down?" }
    },
    {
      "id": "udrzet-nebo-skoncit",
      "label": { "cs": "Udržet, nebo nechat skončit", "en": "Sustain or let it end" },
      "desc": { "cs": "Držet zhasínající řád, nebo vykročit do neznáma za ním?", "en": "Hold on to a fading order, or step into the unknown beyond it?" }
    },
    {
      "id": "zopakuje-se-to",
      "label": { "cs": "Zopakuje se to?", "en": "Will it happen again?" },
      "desc": { "cs": "Poučí se svět z katastrofy, nebo ji v novém šatě zopakuje?", "en": "Will the world learn from the catastrophe, or repeat it in new clothes?" }
    },
    {
      "id": "co-je-clovek",
      "label": { "cs": "Co je člověk", "en": "What is a person" },
      "desc": { "cs": "Kde začíná osoba, když lze vědomí vyrobit, zkopírovat nebo odhodit?", "en": "Where does a person begin when a mind can be made, copied or discarded?" }
    },
    {
      "id": "moc-a-laskavost",
      "label": { "cs": "Moc a laskavost", "en": "Power and kindness" },
      "desc": { "cs": "Co udělá člověk s mocí, za kterou nikdo nepřijde účtovat?", "en": "What does one do with power that no one will ever hold to account?" }
    },
    {
      "id": "vina-a-zmena",
      "label": { "cs": "Vina a změna", "en": "Guilt and change" },
      "desc": { "cs": "Dá se unést vlastní vina – a může se člověk doopravdy změnit?", "en": "Can one bear one's own guilt – and can a person truly change?" }
    }
  ],
