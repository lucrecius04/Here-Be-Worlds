---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/layout.css';
import '../styles/world-card.css';
import '../styles/chronicle.css';
import '../styles/home.css';
import SiteHeader from '../components/i18n/SiteHeader';
import SiteFooter from '../components/i18n/SiteFooter';
import LocaleBridge from '../components/i18n/LocaleBridge';

const { title = 'Here Be Worlds', description = 'Atlas herních vesmírů' } = Astro.props;
import { withBase } from '../lib/base-url';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase(base, '/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var l = localStorage.getItem('hbw_lang');
        document.documentElement.lang = l === 'en' || l === 'cs' ? l : 'cs';
      })();
    </script>
  </head>
  <body>
    <SiteHeader client:load base={base} />
    <LocaleBridge client:load />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter client:load base={base} />
  </body>
</html>
