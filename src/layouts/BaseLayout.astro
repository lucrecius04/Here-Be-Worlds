---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/layout.css';
import '../styles/world-card.css';
import '../styles/chronicle.css';
import '../styles/home.css';
import '../styles/home-page.css';
import '../styles/chapter.css';
import '../styles/compare.css';
import '../styles/map.css';
import '../styles/print.css';
import SiteHeader from '../components/i18n/SiteHeader';
import SiteFooter from '../components/i18n/SiteFooter';
import LocaleBridge from '../components/i18n/LocaleBridge';
import CompareTray from '../components/discovery/CompareTray';
import { worlds } from '../lib/worlds';
import { engravingManifest } from '../lib/trail-images';

const {
  title = 'Here Be Worlds',
  description = 'Here Be Worlds – atlas herních vesmírů a jejich lore. Kroniky, časové osy, mapy a srovnání herních světů.',
  jsonLd,
  noindex = false,
  ogImage = '/og/site.jpg',
  ogImageAlt = 'Here Be Worlds – mapy světů, kam se nedá doletět',
} = Astro.props;
import { withBase } from '../lib/base-url';

const base = import.meta.env.BASE_URL;
// Karty pro sdílení (public/og/, generuje `npm run og`) potřebují absolutní adresu.
const ogImageUrl = new URL(withBase(base, ogImage), Astro.site ?? Astro.url).href;
// Adresa stránky pro og:url (Facebook a Messenger podle ní párují náhled se stránkou).
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Zkušební rytiny k putováním (přepínač ?obrazky=rytina, viz trail-images.ts).
const engravings = engravingManifest(base);
const published = worlds
  .filter((world) => !world.draft)
  .map((world) => ({ id: world.id, gameTitle: world.gameTitle }));
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta property="og:site_name" content="Here Be Worlds" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
    <link rel="icon" href={withBase(base, '/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase(base, '/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase(base, '/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title="Here Be Worlds – novinky" href={withBase(base, '/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var l = localStorage.getItem('hbw_lang');
        document.documentElement.lang = l === 'en' || l === 'cs' ? l : 'cs';
        // Bez uložené volby se web řídí nastavením systému čtenáře.
        var th = localStorage.getItem('hbw_theme');
        if (th !== 'light' && th !== 'dark') {
          th = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', th);
      })();
    </script>
    <script is:inline>
      // Tisk a uložení do PDF: na papír vždy světlý motiv (i barvy archetypů), rozbalené spoilery
      // a načtené obrázky; po tisku se vše vrátí. Vzhled stránky na papíře řeší print.css.
      (function () {
        var saved = null;
        var opened = [];
        window.addEventListener('beforeprint', function () {
          var root = document.documentElement;
          saved = root.getAttribute('data-theme');
          root.setAttribute('data-theme', 'light');
          opened = Array.prototype.filter.call(document.querySelectorAll('details:not([open])'), function (d) {
            d.setAttribute('open', '');
            return true;
          });
          Array.prototype.forEach.call(document.querySelectorAll('img[loading="lazy"]'), function (img) {
            img.loading = 'eager';
          });
        });
        window.addEventListener('afterprint', function () {
          if (saved) document.documentElement.setAttribute('data-theme', saved);
          opened.forEach(function (d) {
            d.removeAttribute('open');
          });
          opened = [];
        });
      })();
    </script>
  </head>
  <body>
    <SiteHeader client:load base={base} />
    <LocaleBridge client:load />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter client:load base={base} />
    <CompareTray client:load worlds={published} base={base.replace(/\/$/, '')} />
    {Object.keys(engravings).length ? (
      <script type="application/json" id="hbw-rytina" set:html={JSON.stringify(engravings)} />
    ) : null}
    <script is:inline>
      /* Zkušební přepínač stylu obrázků k putováním: ?obrazky=rytina | puvodni | vypnout (hbw_obrazky). */
      (function () {
        var KEY = 'hbw_obrazky';
        var el = document.getElementById('hbw-rytina');
        if (!el) return;
        var M = JSON.parse(el.textContent || '{}');
        var q = new URLSearchParams(location.search).get('obrazky');
        var mode = null;
        try {
          if (q === 'rytina' || q === 'puvodni') localStorage.setItem(KEY, q);
          else if (q === 'vypnout') localStorage.removeItem(KEY);
          mode = localStorage.getItem(KEY);
        } catch (e) {}
        if (!mode) return;
        var RE = /\/putovani-obrazky\/([a-z0-9-]+?)(-dark)?\.jpg/;
        function apply(img) {
          var src = img.getAttribute('src') || '';
          if (src.indexOf('/rytina/') >= 0) return;
          var m = RE.exec(src);
          if (!m) return;
          var e = M[m[1] + '.jpg'];
          if (!e) return;
          img.setAttribute('src', e.src);
          var st = img.style;
          if (e.ink && st.getPropertyValue('--pv-mask-ink')) st.setProperty('--pv-mask-ink', 'url("' + e.ink + '")');
          if (e.inkLight && st.getPropertyValue('--pv-mask-ink-light')) st.setProperty('--pv-mask-ink-light', 'url("' + e.inkLight + '")');
        }
        function all() {
          if (mode === 'rytina') document.querySelectorAll('img[src*="/putovani-obrazky/"]').forEach(apply);
        }
        function button() {
          if (document.getElementById('hbw-img-toggle') || !document.querySelector('img[src*="/putovani-obrazky/"]')) return;
          var b = document.createElement('button');
          b.id = 'hbw-img-toggle';
          b.type = 'button';
          b.textContent = 'Obrázky: ' + (mode === 'rytina' ? 'rytina' : 'původní') + ' ⇄';
          b.title = 'Zkušební přepínač stylu obrázků (?obrazky=vypnout ho schová)';
          b.style.cssText = 'position:fixed;left:12px;bottom:12px;z-index:60;font:12px/1 var(--font-mono);padding:8px 10px;background:var(--color-paper);color:var(--color-ink, currentColor);border:1px solid var(--color-line);cursor:pointer';
          b.onclick = function () {
            try { localStorage.setItem(KEY, mode === 'rytina' ? 'puvodni' : 'rytina'); } catch (e) {}
            location.reload();
          };
          document.body.appendChild(b);
        }
        function init() {
          all();
          button();
          if (mode === 'rytina') {
            new MutationObserver(function () { all(); button(); }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });
          } else {
            new MutationObserver(button).observe(document.body, { childList: true, subtree: true });
          }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
      })();
    </script>
  </body>
</html>
