---
/**
 * Přesměrování staré adresy na novou (statický web na GitHub Pages neumí serverové 301).
 * Zachová ?parametry a #kotvu; vyhledávače vede rel=canonical na novou adresu.
 */
interface Props {
  to: string;
}
const { to } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}${to}`;
const absolute = new URL(target, Astro.site ?? 'https://lucrecius04.github.io').href;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <title>Here Be Worlds</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absolute} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <p><a href={target}>Here Be Worlds</a></p>
  </body>
</html>
