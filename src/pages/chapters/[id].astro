---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterPageHeader from '../../components/i18n/ChapterPageTitle';
import ChapterWorldList from '../../components/i18n/ChapterWorldList';
import { chapters, worlds } from '../../lib/worlds';

export function getStaticPaths() {
  return chapters.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const chapter = chapters.find((c) => c.id === id);
if (!chapter) throw new Error(`Unknown chapter: ${id}`);
const list = worlds.filter((w) => w.chapterId === id);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${chapter.title.cs ?? chapter.title.en} — Here Be Worlds`}>
  <ChapterPageHeader client:load base={base} title={chapter.title} thesis={chapter.thesis} />
  <ChapterWorldList client:load worlds={list} base={base} />
</BaseLayout>
