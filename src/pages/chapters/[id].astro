---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterPage from '../../components/discovery/ChapterPage';
import { chapters, worlds } from '../../lib/worlds';

export function getStaticPaths() {
  return chapters.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const chapter = chapters.find((c) => c.id === id);
if (!chapter) throw new Error(`Unknown chapter: ${id}`);
const list = worlds.filter((w) => w.chapterId === id && !w.draft);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${chapter.title.cs ?? chapter.title.en} — Here Be Worlds`}>
  <ChapterPage
    client:load
    id={chapter.id}
    title={chapter.title}
    thesis={chapter.thesis}
    lead={chapter.lead}
    accent={chapter.accent}
    worlds={list}
    base={base.replace(/\/$/, '')}
  />
</BaseLayout>
