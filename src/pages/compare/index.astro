---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparePage from '../../components/compare/ComparePage';
import { chapters, themeTaxonomy, axesMeta } from '../../lib/worlds';
import { kinPublished, kinLabels } from '../../lib/kin-worlds';
import { TRAILS, trailSlug } from '../../lib/trails';
import { publishedEssayFor } from '../../lib/trail-pages';

const base = import.meta.env.BASE_URL;
const themeLabels = Object.fromEntries(themeTaxonomy.map((item) => [item.slug, item.label]));
const chapterCards = chapters.map((chapter) => ({
  id: chapter.id,
  title: chapter.title,
  short: 'short' in chapter ? chapter.short : undefined,
  accent: chapter.accent,
}));
const trails = TRAILS.map((tr) => ({
  id: tr.id,
  slug: trailSlug(tr.id),
  nameKey: tr.nameKey,
  descKey: tr.descKey,
  members: tr.members,
  minutes: publishedEssayFor(tr.id)?.minutes ?? null,
}));
---

<BaseLayout
  title="Srovnání — Here Be Worlds"
  ogImage="/og/compare.jpg"
  ogImageAlt="Srovnání světů – jak blízko mají k sobě dva světy v atlasu Here Be Worlds"
>
  <ComparePage
    client:load
    worlds={kinPublished}
    kinLabels={kinLabels}
    trails={trails}
    chapters={chapterCards}
    themeLabels={themeLabels}
    axes={axesMeta}
    base={base}
  />
</BaseLayout>
