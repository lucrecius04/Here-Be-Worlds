---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparePage from '../../components/compare/ComparePage';
import { worlds, chapters, themeTaxonomy, axesMeta } from '../../lib/worlds';

const base = import.meta.env.BASE_URL;
const themeLabels = Object.fromEntries(themeTaxonomy.map((item) => [item.slug, item.label]));
const chapterCards = chapters.map((chapter) => ({
  id: chapter.id,
  title: chapter.title,
  accent: chapter.accent,
}));
---

<BaseLayout title="Srovnání — Here Be Worlds">
  <ComparePage
    client:load
    worlds={worlds.filter((world) => !world.draft)}
    chapters={chapterCards}
    themeLabels={themeLabels}
    axes={axesMeta}
    base={base}
  />
</BaseLayout>
