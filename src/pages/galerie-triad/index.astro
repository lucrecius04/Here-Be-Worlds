---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TriadGallery from '../../components/triads/TriadGallery';
import { triadChapters, triadWorlds } from '../../lib/triad-pages';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Galerie triád · Here Be Worlds"
  description="Prvotní hříchy a ústřední dilemata všech herních světů atlasu vedle sebe, roztříděné do typů: zadržený konec, lež v základech, lék horší než nemoc…"
>
  <TriadGallery client:load base={base} worlds={triadWorlds} chapters={triadChapters} />
</BaseLayout>
