---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIntro from '../components/discovery/HomeIntro';
import { worlds, chapters } from '../lib/worlds';
import { TRAILS } from '../lib/trails';
import { essayFor } from '../lib/trail-pages';
import { riddleCounts } from '../lib/riddles';
import { anatomyImage } from '../lib/trail-images';

const base = import.meta.env.BASE_URL;

const chapterCards = chapters.map((c) => ({
  id: c.id,
  title: c.title,
  thesis: c.thesis,
  accent: c.accent,
  count: worlds.filter((w) => w.chapterId === c.id && !w.draft).length,
}));

const published = worlds.filter((world) => !world.draft);

// Podklady k putováním na titulní stranu: otázka eseje, úvodní citát a doba čtení (jen u schválených esejí).
function epigraph(markdown: string) {
  const intro = markdown.split(/^## Úvodem\s*$/m)[1] ?? '';
  const quote = /^\*„(.+?)“\*\s*$/m.exec(intro);
  const source = quote ? /^\*\((.+?)\)\*\s*$/m.exec(intro.slice(quote.index + quote[0].length, quote.index + quote[0].length + 200)) : null;
  return quote ? { text: quote[1], source: source?.[1] } : undefined;
}
const journeys = TRAILS.map((trail) => {
  const essay = essayFor(trail.id);
  const approved = Boolean(essay?.approved);
  const quote = approved && essay ? epigraph(essay.markdown) : undefined;
  return {
    id: trail.id,
    tagline: approved ? essay?.tagline : undefined,
    minutes: approved ? essay?.minutes : undefined,
    quote: quote?.text,
    quoteSource: quote?.source,
  };
});
const atlasUrl = `${base.replace(/\/$/, '')}/atlas/`;
---

<BaseLayout
  title="Here Be Worlds — An Atlas of Game Universes · Atlas herních vesmírů a jejich lore"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Here Be Worlds',
    alternateName: ['An Atlas of Game Universes', 'Atlas herních vesmírů'],
    description:
      'Atlas herních vesmírů a jejich lore: kroniky, časové osy, mapy a srovnání herních světů.',
    inLanguage: ['cs', 'en'],
  }}
>
  <script is:inline define:vars={{ atlasUrl }}>
    // Starší odkazy na filtry katalogu (/?theme=…, /?trail=…) vedou do atlasu.
    (function () {
      var q = location.search;
      if (/[?&](theme|trail)=/.test(q)) location.replace(atlasUrl + q + location.hash);
    })();
  </script>
  <HomeIntro client:load chapters={chapterCards} worlds={published} journeys={journeys} riddleCounts={riddleCounts()} essayImage={anatomyImage(base)} base={base.replace(/\/$/, '')} />
</BaseLayout>
