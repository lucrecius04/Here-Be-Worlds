---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasExplorer from '../components/discovery/AtlasExplorer';
import HomeIntro from '../components/discovery/HomeIntro';
import { worlds, chapters, themeTaxonomy } from '../lib/worlds';

const base = import.meta.env.BASE_URL;
const url = new URL(Astro.request.url);
const initialTheme = url.searchParams.get('theme') ?? '';
const homeParam = url.searchParams.get('home');
const homePalette =
  homeParam === 'chart' || homeParam === 'constellation' ? homeParam : 'cabinet';

const chapterCards = chapters.map((c) => ({
  id: c.id,
  title: c.title,
  thesis: c.thesis,
  accent: c.accent,
  count: worlds.filter((w) => w.chapterId === c.id && !w.draft).length,
}));

const themeLabels = Object.fromEntries(themeTaxonomy.map((t) => [t.slug, t.label]));
const published = worlds.filter((world) => !world.draft);
---

<BaseLayout
  title="Here Be Worlds — An Atlas of Game Universes · Atlas herních vesmírů a jejich lore"
  homePalette={homePalette}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Here Be Worlds',
    alternateName: ['An Atlas of Game Universes', 'Atlas herních vesmírů'],
    description:
      'Atlas herních vesmírů a jejich lore: kroniky, časové osy, mapy a srovnání herních světů.',
    inLanguage: ['cs', 'en'],
  }}
>
  <HomeIntro
    client:load
    chapters={chapterCards}
    worlds={published}
    base={base.replace(/\/$/, '')}
  />
  <AtlasExplorer
    client:load
    worlds={published}
    chapters={chapterCards}
    themeLabels={themeLabels}
    baseUrl={base.replace(/\/$/, '')}
    initialTheme={initialTheme}
  />
</BaseLayout>
