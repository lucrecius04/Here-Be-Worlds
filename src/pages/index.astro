---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIntro from '../components/discovery/HomeIntro';
import { worlds, chapters } from '../lib/worlds';

const base = import.meta.env.BASE_URL;

const chapterCards = chapters.map((c) => ({
  id: c.id,
  title: c.title,
  thesis: c.thesis,
  accent: c.accent,
  count: worlds.filter((w) => w.chapterId === c.id && !w.draft).length,
}));

const published = worlds.filter((world) => !world.draft);
const atlasUrl = `${base.replace(/\/$/, '')}/atlas/`;
---

<BaseLayout
  title="Here Be Worlds — An Atlas of Game Universes · Atlas herních vesmírů a jejich lore"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Here Be Worlds',
    alternateName: ['An Atlas of Game Universes', 'Atlas herních vesmírů'],
    description:
      'Atlas herních vesmírů a jejich lore: kroniky, časové osy, mapy a srovnání herních světů.',
    inLanguage: ['cs', 'en'],
  }}
>
  <script is:inline define:vars={{ atlasUrl }}>
    // Starší odkazy na filtry katalogu (/?theme=…, /?trail=…) vedou do atlasu.
    (function () {
      var q = location.search;
      if (/[?&](theme|trail)=/.test(q)) location.replace(atlasUrl + q + location.hash);
    })();
  </script>
  <HomeIntro client:load chapters={chapterCards} worlds={published} base={base.replace(/\/$/, '')} />
</BaseLayout>
