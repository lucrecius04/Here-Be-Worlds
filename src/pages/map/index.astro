---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoordinateMap from '../../components/discovery/CoordinateMap';
import { chapters, themeTaxonomy, worlds } from '../../lib/worlds';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const published = worlds.filter((world) => !world.draft);
const chapterLite = chapters.map((chapter) => ({
  id: chapter.id,
  title: chapter.title,
  short: 'short' in chapter ? chapter.short : undefined,
  accent: chapter.accent,
}));
const themeLabels = Object.fromEntries(themeTaxonomy.map((theme) => [theme.slug, theme.label]));
---

<BaseLayout title="Mapa souřadnic — Here Be Worlds">
  <CoordinateMap client:load worlds={published} chapters={chapterLite} themeLabels={themeLabels} base={base} />
</BaseLayout>
