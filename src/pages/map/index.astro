---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConstellationMap from '../../components/discovery/ConstellationMap';
import { chapters, worlds } from '../../lib/worlds';

const base = import.meta.env.BASE_URL;
const published = worlds.filter((world) => !world.draft);
const chapterCards = chapters.map((chapter) => ({
  id: chapter.id,
  title: chapter.title,
  accent: chapter.accent,
}));
---

<BaseLayout title="Mapa — Here Be Worlds">
  <ConstellationMap
    client:load
    worlds={published}
    chapters={chapterCards}
    base={base.replace(/\/$/, '')}
  />
</BaseLayout>
