---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AxisGridMap from '../../components/discovery/AxisGridMap';
import { chapters, themeTaxonomy, worlds } from '../../lib/worlds';

const base = import.meta.env.BASE_URL;
const published = worlds.filter((world) => !world.draft);
const chapterCards = chapters.map((chapter) => ({
  id: chapter.id,
  title: chapter.title,
  accent: chapter.accent,
}));
// Témata v nabídce zvýraznění: jen ta, která má aspoň jeden publikovaný svět, od nejčastějších.
const themeCount = (slug: string) => published.filter((w) => w.themes.includes(slug)).length;
const themes = themeTaxonomy
  .filter((theme) => themeCount(theme.slug) > 0)
  .sort((a, b) => themeCount(b.slug) - themeCount(a.slug))
  .map((theme) => ({ slug: theme.slug, label: theme.label }));
---

<BaseLayout title="Kartografie os — Here Be Worlds">
  <AxisGridMap client:load worlds={published} chapters={chapterCards} themes={themes} base={base.replace(/\/$/, '')} />
</BaseLayout>
