---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NarrationPage from '../../components/narration/NarrationPage';
import { NARR_FAMILIES, NARR_RINGS, NARR_TECHNIQUES, OWN_FROM, narrTools, narrWorlds, narrChapters, familyCounts } from '../../lib/narrative-tools';
import { TRAILS, trailSlug } from '../../lib/trails';
import { uiT } from '../../lib/i18n';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Šest kruhů od slova k hráči; první tři z jiných umění, od Činu dál z hraní. Skupina mimo kruhy = vlastnosti světa.
const rings = NARR_RINGS.map((f, i) => ({ ...f, own: i >= OWN_FROM }));
const outsideFamily = NARR_FAMILIES.find((f) => f.outside)!;
const outside = { ...outsideFamily, own: false };

const techniques = NARR_TECHNIQUES.map((tech) => {
  const trail = tech.trail ? TRAILS.find((x) => x.id === tech.trail) : undefined;
  return {
    ...tech,
    trail: trail ? { slug: trailSlug(trail.id), label: { cs: uiT(trail.nameKey, 'cs'), en: uiT(trail.nameKey, 'en') } } : undefined,
  };
});

const worlds = narrWorlds.map((w) => ({ id: w.id, title: w.title, chapterId: w.chapterId, accent: w.accent, anchor: w.anchor, counts: familyCounts(w.id) }));
---

<BaseLayout
  title="Poetika světů · Here Be Worlds"
  description="Poetika herních světů: vypravěčské nástroje všech světů atlasu v šesti kruzích od slova k hráči: Slovo a stavba, Obraz a zvuk, Prostor a stopy (z jiných umění) a Čin a pravidla, Zákulisí a Hráč (z hraní)."
>
  <NarrationPage client:load base={base} rings={rings} outside={outside} techniques={techniques} tools={narrTools} worlds={worlds} chapters={narrChapters} />
</BaseLayout>
