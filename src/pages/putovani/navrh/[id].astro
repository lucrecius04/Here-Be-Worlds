---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EssayPage from '../../../components/essay/EssayPage';
import { trailById } from '../../../lib/trails';
import { trailEssays, trailWorldsInfo, worldLinks } from '../../../lib/trail-pages';

/** Náhled eseje ke stezce před schválením (/putovani/navrh/<slug>/): z webu na něj nic nevede. */
export function getStaticPaths() {
  return trailEssays.map((essay) => ({ params: { id: essay.slug }, props: { essay } }));
}

const { essay } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Náhled: ${essay.title} — Here Be Worlds`} description={essay.description} noindex>
  <EssayPage
    client:load
    base={base}
    markdown={essay.markdown}
    title={essay.title}
    kicker={essay.approved ? essay.kicker : `${essay.kicker ?? 'Putování atlasu'} · náhled ke schválení`}
    tagline={essay.tagline}
    worlds={worldLinks}
    trail={{ worlds: trailWorldsInfo(trailById(essay.trailId)) }}
  />
</BaseLayout>
