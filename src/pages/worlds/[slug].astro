---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorldPageShell from '../../components/world/WorldPageShell';
import {
  worlds,
  getWorldById,
  getChapterById,
  chapters,
  themeTaxonomy,
  resolveRelatedWorlds,
} from '../../lib/worlds';
import { kinWorlds } from '../../lib/kin-worlds';
import { t } from '../../lib/i18n';
import { TRAILS, trailSlug } from '../../lib/trails';
import { publishedEssayFor } from '../../lib/trail-pages';
import { trailImages } from '../../lib/trail-images';
import { chronicleImageSizes } from '../../lib/chronicle-images';

export function getStaticPaths() {
  return worlds.map((w) => ({ params: { slug: w.id } }));
}

const { slug } = Astro.params;
const world = getWorldById(slug!);
if (!world) throw new Error(`Unknown world: ${slug}`);

const base = import.meta.env.BASE_URL;
const chapter = getChapterById(world.chapterId);
const themeLabels = Object.fromEntries(themeTaxonomy.map((th) => [th.slug, th.label]));
const baseUrl = base.replace(/\/$/, '');
// Příbuzenstvo počítá compare.ts nad světy doplněnými o triádu, vyprávění a paměť (kin-worlds.ts).
const related = resolveRelatedWorlds(world, kinWorlds, themeLabels, baseUrl);
const chapterAccents = Object.fromEntries(chapters.map((c) => [c.id, { ...c.accent, title: c.title }]));

// Putování, kterými svět prochází (záložka Putování): trasa světů v barvách archetypů.
const accentOf = (id: string) => chapters.find((c) => c.id === id)?.accent ?? { light: 'currentColor', dark: 'currentColor' };
const journeys = TRAILS.filter((tr) => tr.members.includes(world.id)).map((tr) => {
  const essay = publishedEssayFor(tr.id);
  return {
    id: tr.id,
    slug: trailSlug(tr.id),
    nameKey: tr.nameKey,
    descKey: tr.descKey,
    tagline: essay?.tagline,
    minutes: essay?.minutes ?? null,
    members: tr.members
      .map((id) => worlds.find((w) => w.id === id))
      .filter((w): w is NonNullable<typeof w> => Boolean(w && !w.draft))
      .map((w) => ({ id: w.id, title: w.gameTitle, accent: accentOf(w.chapterId) })),
    // první kresba putování jako náhled (obrázky se ukazují jen u schválené eseje)
    image: essay ? trailImages(base, tr.id)[0] : undefined,
  };
});

// Rozměry obrázků kroniky, aby se text při jejich dočtení neposouval (skoky z obsahu).
const imageSizes = chronicleImageSizes(world.chronicleSlug);

const pageTitle = `${t(world.gameTitle, 'cs')} — Here Be Worlds`;
---

<BaseLayout
  title={pageTitle}
  description={t(world.core, 'cs')}
  ogImage={world.draft ? undefined : `/og/worlds/${world.id}.jpg`}
  ogImageAlt={world.draft ? undefined : `${t(world.gameTitle, 'cs')} – karta světa v atlasu Here Be Worlds`}
>
  <WorldPageShell
    client:load
    base={base}
    baseUrl={baseUrl}
    world={world}
    chapterTitle={chapter?.title}
    chapterAccent={chapter?.accent}
    themeLabels={themeLabels}
    related={related}
    chapterAccents={chapterAccents}
    journeys={journeys}
    imageSizes={imageSizes}
  />
</BaseLayout>
