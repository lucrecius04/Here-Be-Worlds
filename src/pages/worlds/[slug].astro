---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorldPageShell from '../../components/world/WorldPageShell';
import {
  worlds,
  getWorldById,
  getChapterById,
  chapters,
  themeTaxonomy,
  resolveRelatedWorlds,
} from '../../lib/worlds';
import { t } from '../../lib/i18n';
import { chronicleStats } from '../../lib/chronicle-toc';

const CHRONICLES = import.meta.glob('../../../content/chronicles/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

export function getStaticPaths() {
  return worlds.map((w) => ({ params: { slug: w.id } }));
}

const { slug } = Astro.params;
const world = getWorldById(slug!);
if (!world) throw new Error(`Unknown world: ${slug}`);

const base = import.meta.env.BASE_URL;
const chapter = getChapterById(world.chapterId);
const themeLabels = Object.fromEntries(themeTaxonomy.map((th) => [th.slug, th.label]));
const baseUrl = base.replace(/\/$/, '');
const related = resolveRelatedWorlds(world, worlds, themeLabels, baseUrl);
const chapterIndex = chapters.findIndex((c) => c.id === world.chapterId);
const chapterAccents = Object.fromEntries(chapters.map((c, i) => [c.id, { ...c.accent, letter: 'ABCDEFGHIJ'[i] }]));

// Obsah záložek (kapitoly, doba čtení, oddíly) se spočítá z kroniky už při sestavení.
const rawChronicle = CHRONICLES[`../../../content/chronicles/${world.chronicleSlug}.md`] ?? '';
const tabStats = chronicleStats(rawChronicle.replace(/^---\r?\n[\s\S]*?\r?\n---\s*/, ''));

const pageTitle = `${t(world.gameTitle, 'cs')} — Here Be Worlds`;
---

<BaseLayout
  title={pageTitle}
  description={t(world.core, 'cs')}
  ogImage={world.draft ? undefined : `/og/worlds/${world.id}.jpg`}
  ogImageAlt={world.draft ? undefined : `${t(world.gameTitle, 'cs')} – karta světa v atlasu Here Be Worlds`}
>
  <WorldPageShell
    client:load
    base={base}
    baseUrl={baseUrl}
    world={world}
    chapterTitle={chapter?.title}
    chapterAccent={chapter?.accent}
    themeLabels={themeLabels}
    related={related}
    chapterLetter={'ABCDEFGHIJ'[chapterIndex] ?? ''}
    chapterAccents={chapterAccents}
    tabStats={tabStats}
  />
</BaseLayout>
